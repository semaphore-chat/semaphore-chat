{
  "name": "semaphore-chat",
  "private": true,
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "build:shared": "pnpm --filter shared run build",
    "prepare": "pnpm run build:shared"
  },
  "dependencies": {
    "class-validator": "^0.15.1",
    "class-transformer": "^0.5.1"
  },
  "pnpm": {
    "patchedDependencies": {
      "livekit-client@2.22.3": "patches/livekit-client@2.22.3.patch"
    },
    "overrides": {
      "form-data": "^4.0.6",
      "ws": "^8.21.0",
      "multer": "^2.3.0",
      "mysql2": "^3.23.1",
      "brace-expansion@1": "^1.1.18",
      "deepmerge-ts": "^8.0.0",
      "builder-util-runtime": "^9.7.0",
      "engine.io": "^6.6.10",
      "js-yaml@4": "^4.3.2",
      "react-router": "^7.18.2",
      "socket.io": "^4.8.4",
      "socket.io-parser": "^4.2.7",
      "tar": "^7.5.19",
      "source-map-js": "^1.2.2"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint-plugin-jsx-a11y>eslint": "10"
      }
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "@suites/di.nestjs",
      "@suites/doubles.jest",
      "@swc/core",
      "bcrypt",
      "esbuild",
      "msw",
      "prisma",
      "sharp"
    ]
  }
}
