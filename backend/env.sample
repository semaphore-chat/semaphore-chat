# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL=postgresql://semaphore:semaphore@postgres:5432/semaphore
JWT_SECRET=some long elaborate secret that you really need to change
JWT_REFRESH_SECRET=a different long elaborate secret to change
REDIS_HOST=redis

# Number of trusted reverse-proxy hops between the client and Semaphore Chat.
# Needed for correct rate-limiting and session IPs behind a proxy.
# Unset = no proxy trusted (the client address is the TCP peer).
# "1" = one proxy (Nginx, Traefik, etc.). In dev, the Vite proxy is that one hop.
# Use "2" if there is a CDN in front. Never set it higher than the real number
# of hops, and never "true". The backend port must only be reachable through
# the proxy, or clients can spoof their IP with an X-Forwarded-For header.
# Set to "loopback" or a specific subnet for tighter control.
# See: https://expressjs.com/en/guide/behind-proxies.html
TRUST_PROXY=1

# LiveKit Configuration (local dev defaults — override for external LiveKit)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret-that-is-at-least-32-characters-long
# Internal URL for server-to-server LiveKit API calls (Docker network)
LIVEKIT_INTERNAL_URL=http://livekit:7880

# Replay Buffer Configuration
REPLAY_SEGMENTS_PATH=/app/storage/replay-segments
REPLAY_EGRESS_OUTPUT_PATH=/out
REPLAY_SEGMENT_CLEANUP_AGE_MINUTES=20
#
# Orphaned segment directory sweep — hourly filesystem-first cleanup pass
# that deletes segment directories on disk with no matching (or no longer
# active) egressSession DB row. Catches directories the row-driven cleanup
# paths can't (wiped row, missed webhook, a one-time delete that failed).
# REPLAY_ORPHAN_SWEEP_ENABLED=true (default; set "false" to disable)
# REPLAY_ORPHAN_SWEEP_GRACE_HOURS=24 (default; min directory age before deletion)

# File Storage Backend (message attachments, avatars, banners, emoji, sounds)
# STORAGE_TYPE=LOCAL (default) stores uploads on the local filesystem at
# FILE_UPLOAD_DEST. STORAGE_TYPE=S3 stores them in an S3-compatible bucket
# instead — FILE_UPLOAD_DEST is still used as local scratch space (multer
# staging + ffmpeg thumbnail generation need a real file on disk).
# Storage is resolved per file record, so switching STORAGE_TYPE only
# affects new uploads; existing files keep working from wherever they were
# originally stored.
# STORAGE_TYPE=LOCAL
# FILE_UPLOAD_DEST=./uploads
#
# S3_* vars below are required only when STORAGE_TYPE=S3. For local dev
# against the MinIO service (docker compose --profile s3 up -d minio):
# STORAGE_TYPE=S3
# S3_BUCKET=semaphore-dev
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_ENDPOINT=http://minio:9000
# S3_FORCE_PATH_STYLE=true

# Push Notifications (Web Push / VAPID)
# Generate keys with: npx web-push generate-vapid-keys
# Each instance needs unique keys - treat like JWT secrets
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@your-instance.com

# Self-Service Password Reset via Email (SMTP)
# Feature is auto-disabled unless SMTP_HOST, SMTP_FROM, and PUBLIC_APP_URL
# are all set. SMTP_USER/SMTP_PASS are optional but must be set together.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Semaphore Chat <noreply@your-instance.com>"
# PUBLIC_APP_URL is also used to build absolute incoming-webhook execution
# URLs; when unset, webhook URLs are returned as relative API paths.
# PUBLIC_APP_URL=https://chat.your-instance.com

# Admin Debug Panel (WebSocket event emitter for testing)
# ADMIN_DEBUG_PANEL=true

# Prometheus metrics at /api/metrics (unauthenticated — restrict at the
# reverse proxy if your deployment is public)
# METRICS_ENABLED=true

# Thumbnail backfill (retries missing video thumbnails on startup)
# Deferred and batched to avoid startup memory spikes: at most one ffmpeg
# frame-extraction child runs at a time (30s max), and the DB working set
# per batch is THUMBNAIL_BACKFILL_BATCH_SIZE rows of just { id, storagePath }.
# THUMBNAIL_BACKFILL_ENABLED=true
# THUMBNAIL_BACKFILL_BATCH_SIZE=25
# THUMBNAIL_BACKFILL_STARTUP_DELAY_MS=60000
# THUMBNAIL_BACKFILL_THROTTLE_MS=1000

# GIF Search (Giphy)
# Get a free API key at https://developers.giphy.com/dashboard/
# Feature is off (GIF picker hidden, /gifs endpoints return 503) when absent.
# (TENOR_API_KEY is deprecated and ignored as of this version.)
GIPHY_API_KEY=

# Background jobs (BullMQ) — message notification fan-out + link previews.
# Uses REDIS_HOST/REDIS_PORT/REDIS_PASSWORD/REDIS_DB (same vars as the app's
# main Redis client) but opens its own connection, since BullMQ requires
# maxRetriesPerRequest: null. Processors run in-process on this container.
# JOB_WORKER_CONCURRENCY: max jobs processed in parallel per queue per process.
# JOB_WORKER_CONCURRENCY=4

# Max community size for CHANNEL_MESSAGE notification fan-out. Public
# channels in communities above this member count skip fan-out (logged as a
# WARN) to avoid overwhelming the DB on self-hosted instances.
# CHANNEL_MESSAGE_MEMBER_THRESHOLD=5000
