{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "setupFiles": ["<rootDir>/helpers/setup-env.ts"],
  "maxWorkers": 1,
  "testTimeout": 30000,
  "transform": {
    "/node_modules/.+\\.js$": "<rootDir>/jest-esm-transformer.js",
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/../src/$1",
    "^@semaphore-chat/shared$": "<rootDir>/../../shared/src",
    "^@semaphore-chat/shared/(.*)$": "<rootDir>/../../shared/src/$1"
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(uuid|@nestjs/config)/)"
  ]
}
