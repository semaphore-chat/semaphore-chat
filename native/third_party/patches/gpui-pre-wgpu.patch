+    /// One uniform buffer + bind group per surface in the scene.
+    fn prepare_surface_bindings(&mut self, scene: &Scene) {
+        let store = self.atlas.video_store().clone();
+        let surfaces = &scene.surfaces;
+        let resources = &mut self.resources;
+        resources
+            .surface_bindings
+            .retain(|id, _| surfaces.iter().any(|surface| surface.video == *id));
+        for surface in surfaces {
+            let Some(texture) = store.get(surface.video) else {
+                resources.surface_bindings.remove(&surface.video);
+                continue;
+            };
+            let current = resources
+                .surface_bindings
+                .get(&surface.video)
+                .is_some_and(|binding| binding.generation == texture.generation);
+            if !current {
+                let params = resources.device.create_buffer(&wgpu::BufferDescriptor {
+                    label: Some("surface_params"),
+                    size: std::mem::size_of::<SurfaceParams>() as u64,
+                    usage: wgpu::BufferUsages::UNIFORM | wgpu::BufferUsages::COPY_DST,
+                    mapped_at_creation: false,
+                });
+                let bind_group = resources.device.create_bind_group(&wgpu::BindGroupDescriptor {
+                    label: Some("surface_bind_group"),
+                    layout: &resources.bind_group_layouts.surfaces,
+                    entries: &[
+                        wgpu::BindGroupEntry { binding: 0, resource: params.as_entire_binding() },
+                        wgpu::BindGroupEntry {
+                            binding: 1,
+                            resource: wgpu::BindingResource::TextureView(&texture.y_view),
+                        },
+                        wgpu::BindGroupEntry {
+                            binding: 2,
+                            resource: wgpu::BindingResource::TextureView(&texture.uv_view),
+                        },
+                        wgpu::BindGroupEntry {
+                            binding: 3,
+                            resource: wgpu::BindingResource::Sampler(&resources.atlas_sampler),
+                        },
+                    ],
+                });
+                resources.surface_bindings.insert(
+                    surface.video,
+                    SurfaceBinding { generation: texture.generation, params, bind_group },
+                );
+            }
+            let binding = &resources.surface_bindings[&surface.video];
+            let radii = surface.corner_radii;
+            let params = SurfaceParams {
+                bounds: surface.bounds.into(),
