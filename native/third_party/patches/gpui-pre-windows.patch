+                DirectXVideoTexture::write_plane(
+                    &device_context,
+                    &texture.y,
+                    &frame.y,
+                    frame.y_stride,
+                    frame.width,
+                    frame.height,
+                )?;
+                DirectXVideoTexture::write_plane(
