server post_as "{\"channelId\": \"$ID(cc-general)\", \"authorId\": \"$ID(u-priya)\", \"text\": \"w9needle 51\"}"
navigate /community/$ID(c-couch)/channel/$ID(cc-general)/search
wait core channel $ID(cc-general)
wait core side-panel search
expect focused "Search messages"
type "w9needle"
tick 400
wait core requests MessagesController_searchChannelMessages >= 1
wait core search-hits >= 1
wait core w9 search-more shown
wait idle
shot 10-search-more
click search-more
wait core search-hits >= 51
wait core w9 search-more gone
wait idle
shot 11-search-next-page

# 6. A group DM: "Add people" adds Kwame, and "Leave group" goes back to the conversations.
navigate /direct-messages/$ID(dm-launch)
wait core element dm-header-more
wait core w9 group-actions shown
wait idle
shot 12-group-dm
click dm-header-more
wait core element dm-add-people
click dm-add-people
wait core element add-people-field
click add-people-field
type "kwam"
tick 400
wait core element add-people-user-$ID(u-kwame)
click add-people-user-$ID(u-kwame)
wait idle
shot 13-add-people
click add-people-submit
wait core no-element add-people-submit
wait core requests DirectMessagesController_addMembers >= 1
wait core w9 dm-members 4
wait idle
shot 14-group-grew
click dm-header-more
wait core element dm-leave
click dm-leave
wait core element dm-leave-confirm
wait idle
shot 15-leave-group
click dm-leave-confirm
wait core route dms
wait core dms 4

# 7. The shortcuts: Ctrl+/ shows the web's sheet, Escape closes it, Alt+Down is the next channel.
navigate /community/$ID(c-couch)/channel/$ID(cc-general)
wait core channel $ID(cc-general)
press ctrl-/
wait core w9 sheet open
wait idle
shot 16-shortcuts
press escape
wait core w9 sheet closed
press alt-down
wait core route channel/$ID(cc-clips)
press alt-shift-down
wait core route channel/$ID(cc-lfg)

# About, from the account menu (the app menu's Help item is drawn only on platforms with a native
# menu bar): it names the version this build reports, and Escape closes it, leaving the
# conversation where it was.
click rail-account
wait core element account-about
click account-about
wait core element about
wait core label "Version $VERSION"
press escape
wait core no-element about
wait core channel $ID(cc-lfg)

# 8. Escape in the pane, as the shortcut sheet says: one thing per press. With the focus in the
# composer the pane's own binding has the key, after the composer's (nothing open) and the list's
# (nothing selected): the pins panel closes and the conversation stays where it is.
navigate /community/$ID(c-couch)/channel/$ID(cc-general)
wait core channel $ID(cc-general)
click header-pins
wait core side-panel pins
click composer-field
press escape
wait core side-panel none
wait core channel $ID(cc-general)

# 9. A jump into history leaves the list detached from the live edge, and the pane marks read only
# at the live edge: another user's message then stays unread on screen until Escape marks the
# conversation read, wherever it is.
#
# A window of a usual size, opened over the session the tall one keeps: in the tall window the
# whole gap fits on screen at once and the list walks back to the live edge by itself. ch-dev's
# first page is a hundred messages behind its oldest, so a search jump to that message (the same
# `open_conversation_at` a pin's or a link's jump goes through) detaches the window. The side
# panel goes before Escape, which is the pane's then.
app 1600 1400
window activate
wait core session signed-in
server post_as "{\"channelId\": \"$ID(ch-dev)\", \"authorId\": \"$ID(u-priya)\", \"text\": \"w9 dev 1\"}"
server post_as "{\"channelId\": \"$ID(ch-dev)\", \"authorId\": \"$ID(u-priya)\", \"text\": \"w9 dev 2\"}"
