# W2: DMs, friends, notifications and links in the real app, against the showcase scenario (alexk).
# The rig's notifier records what the app raises and its virtual speaker what the app plays: nothing
# reaches the desktop. Each part checks the server and core, then takes a shot.

app 1280 800
# In front, as a user's window is: what the pane shows is read, and notifies nothing.
window activate
wait idle
click auth-connect
wait core session signed-out within 5
wait idle

# 0. A link that arrives before sign-in is kept, and the session lands on it.
link "semaphore://community/$ID(c-couch)/channel/$ID(cc-lfg)"
click auth-username
type "alexk"
click auth-password
type "hunter2"
click auth-login
wait core session signed-in
wait core channel $ID(cc-lfg)
wait core text "need one more"
wait idle
shot 00-link-before-sign-in

# 1. The DMs: the list, then a conversation under its header. Sending in it.
click rail-dm
wait core dms 5
wait core element dm-sidebar
wait idle
shot 01-dm-list
click dm-row-$ID(dm-priya)
wait core dm $ID(dm-priya)
wait core text "dropbear is never living that down"
wait core element dm-header
wait idle
shot 02-dm-open
type "lunch at noon?"
press enter
wait core sent "lunch at noon?"
expect requests sendDirectMessage >= 1
wait idle
shot 03-dm-sent

# 2. Wave 1's message features in a DM: edit, a unicode reaction, a thread, search. Pins and
# custom emoji are channel things: neither is offered.
hover-row message "lunch at noon?"
expect core element message-action-edit
expect core no-element message-action-pin
wait idle
shot 04-dm-toolbar
click message-action-edit
wait core editing yes
type " (the usual place)"
press enter
wait core edited "lunch at noon? (the usual place)"
expect requests MessagesController_update >= 1
hover-row message "lunch at noon?"
click message-action-react
wait core picker open
type "fire"
click "emoji-🔥"
wait core picker closed
wait core reaction "lunch at noon?" "🔥" 1
expect requests MessagesController_addReaction >= 1
hover-row message "lunch at noon?"
click message-action-thread
wait core side-panel thread
type "or one?"
press enter
wait core thread-sent "or one?"
expect requests sendThreadReply >= 1
wait idle
shot 05-dm-thread
click thread-close
wait core side-panel none
click dm-header-search
wait core side-panel search
type "dropbear"
tick 400
wait core requests MessagesController_searchDirectMessages >= 1
wait core search-hits >= 1
wait idle
shot 06-dm-search
click dm-header-search
wait core side-panel none

# 3. A group: two people picked from one search, and a name.
click dm-new
wait core element create-dm-picker
type "sam"
wait idle
tick 400
wait core requests UserController_searchUsers >= 1
wait idle
click create-dm-user-$ID(u-samira)
click create-dm-field
press backspace
press backspace
press backspace
type "mat"
wait idle
tick 400
wait core requests UserController_searchUsers >= 2
wait idle
click create-dm-user-$ID(u-mateo)
click create-dm-name
type "Weekend plan"
wait idle
shot 07-group-dialog
click create-dm-create
wait core dms 6
wait core no-element create-dm-picker
expect requests DirectMessagesController_createDmGroup >= 1
wait idle
shot 08-group-created

# 4. A friend request from someone else: it shows when the list is read, and accepting it makes a
# friend.
server friend_request_as "{\"fromId\": \"$ID(u-zara)\", \"id\": \"w2-zara\"}"
click dm-tab-friends
wait core incoming 2
click friends-tabs-1
wait core element request-$ID(w2-zara)
wait idle
shot 09-friend-request
click request-accept-$ID(w2-zara)
wait core friend $ID(u-zara)
wait core incoming 1
expect requests FriendsController_acceptFriendRequest >= 1
wait idle
shot 10-friend-accepted
click dm-tab-messages

# 5. A mention from another user raises a notification (with the mention sound), and reading the
# channel takes it down.
expect core sound silent
server post_as "{\"channelId\": \"$ID(cc-general)\", \"authorId\": \"$ID(u-priya)\", \"text\": \"look at this \", \"mentionUserId\": \"$ID(me)\"}"
wait core notified channel:$ID(cc-general)
wait core sound heard
wait idle
shot 11-mention-raised
click community-$ID(c-couch)
click channel-$ID(cc-general)
wait core channel $ID(cc-general)
wait core withdrawn channel:$ID(cc-general)

# 6. A DM from another user, and a click on its notification: the DM opens, and the server has it
# read.
forget sounds
server post_dm_as "{\"dmGroupId\": \"$ID(dm-grace)\", \"authorId\": \"$ID(u-grace)\", \"text\": \"are you around later?\"}"
wait core notified dm:$ID(dm-grace)
wait core sound heard
notification click dm:$ID(dm-grace)
wait core dm $ID(dm-grace)
wait core text "are you around later?"
wait core requests NotificationsController_markAsRead >= 1
wait core withdrawn dm:$ID(dm-grace)
wait idle
shot 12-notification-clicked

# 7. The centre lists them; mark all read empties the badge.
click rail-notifications
wait core centre open
wait core element notification-center
wait idle
shot 13-centre
click notifications-mark-all
wait core badge 0
expect requests NotificationsController_markAllAsRead >= 1
wait idle
shot 14-centre-all-read
click rail-notifications
wait core centre closed

# 8. A deep link while signed in: a DM, then a channel, both through the parser.
link "semaphore://direct-messages/$ID(dm-kwame)"
wait core dm $ID(dm-kwame)
wait idle
shot 15-link-dm
link "semaphore://community/$ID(c-couch)/channel/$ID(cc-memes)"
wait core channel $ID(cc-memes)
wait idle
shot 16-link-channel
