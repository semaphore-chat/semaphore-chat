# W0: the floor every wave builds on: sign in against the showcase scenario, one static shot.
# Later waves add their own *.steps files beside this one; slice-e2e.sh runs them all.
app 1280 800
wait idle
click auth-connect
wait core session signed-out within 5
wait idle
click auth-username
type "alexk"
click auth-password
type "hunter2"
click auth-login
wait core session signed-in
wait core channel $ID(cc-general)
wait core rows >= 5
wait idle
shot 00-signed-in
expect requests AuthController_login >= 1
