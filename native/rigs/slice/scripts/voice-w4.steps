# W4: calls against a real LiveKit (lk-stack) and the fake server minting real tokens. Run by
# `slice-e2e.sh --voice` after voice.steps. Two publishers are there before the app starts:
# `demo-peer` (video) in Squad Up, and priya (`$ID(u-priya)`, video) in her DM's room, so the DM
# call has someone in it once the app answers. Snaps named *-live-* carry video and aren't compared.

app 1280 800
click auth-connect
wait core label "Username" within 5
click auth-username
type "alexk"
click auth-password
type "hunter2"
click auth-login
wait core session signed-in
wait core channel $ID(cc-general)
wait core connection connected
expect core keep-awake off

# 1. Priya calls. Declined first: nothing joins.
server dm_call_join "{\"dmGroupId\": \"$ID(dm-priya)\", \"userId\": \"$ID(u-priya)\"}"
wait core ringing $ID(dm-priya)
wait core ring looping
click incoming-decline
wait core ringing no
wait core ring stopped
expect core voice room none

# 2. She calls again and the app answers: her conversation, the call above it, her video, the
# system kept awake, the connected cue.
server dm_call_leave "{\"dmGroupId\": \"$ID(dm-priya)\", \"userId\": \"$ID(u-priya)\"}"
server dm_call_join "{\"dmGroupId\": \"$ID(dm-priya)\", \"userId\": \"$ID(u-priya)\"}"
wait core ringing $ID(dm-priya)
click incoming-accept
wait core voice connected within 30
wait core voice room dm $ID(dm-priya)
wait core route dm/$ID(dm-priya)
wait core ringing no
wait core ring stopped
wait core voice participant $ID(u-priya) within 30
wait core voice frames within 30
wait core keep-awake on
wait core cue connected 1
wait core element dm-stage-split
wait core element dm-call-in-call
tick 100
snap 01-live-dm-call

# Elsewhere, the call floats over the column, with the bar under it.
click community-$ID(c-couch)
click channel-$ID(cc-general)
wait core channel $ID(cc-general)
wait core float shown
wait core label "Share screen"
tick 100
snap 02-live-float

# Leaving from the bar: the inhibitor goes, the disconnected cue plays.
click voice-leave
wait core voice disconnected within 15
wait core voice room none
wait core keep-awake off
wait core cue disconnected 1
wait core float hidden
server dm_call_leave "{\"dmGroupId\": \"$ID(dm-priya)\", \"userId\": \"$ID(u-priya)\"}"

# 3. Squad Up: the soundboard. Rimshot (Ogg Opus, decoded built in) goes out on the published
# `soundboard` track LiveKit lists, and we hear it too. The row shows the pre-join (WP).
click channel-$ID(vc-squad)
wait core element voice-prejoin-join
click voice-prejoin-join
wait core voice connected within 30
wait core voice participant demo-peer within 30
wait core keep-awake on
click voice-soundboard
# c-couch's Rimshot: entity_uuid("sound:<c-couch's uuid>:Rimshot").
wait core element sound-d0424970-cbfa-5e9a-a0b0-d2472bc106e1 within 15
tick 100
snap 03-live-soundboard
forget sounds
click sound-d0424970-cbfa-5e9a-a0b0-d2472bc106e1
wait core livekit track $ID(vc-squad) $ID(me) soundboard within 15
wait core sound heard within 15

# 4. A moderator mutes me: the mic can't come back until they lift it.
server server_mute "{\"channelId\": \"$ID(vc-squad)\", \"userId\": \"$ID(me)\", \"mute\": true}"
wait core voice server-muted yes
wait core voice muted
wait core label "A moderator muted you"
tick 100
snap 04-live-server-muted
# Lifted: the mic stays off until I turn it on, as on the web.
server server_mute "{\"channelId\": \"$ID(vc-squad)\", \"userId\": \"$ID(me)\", \"mute\": false}"
wait core voice server-muted no
expect core voice muted
click voice-mic
wait core voice unmuted

# 5. The participant menu on demo-peer's tile: muted for me (saved), then, as the community's
# owner, a server mute.
right-click tile-demo-peer-camera
wait core dialog participant-menu open
tick 100
snap 05-live-participant-menu
click participant-local-mute
wait core dialog participant-menu closed
expect settings /user_volumes/demo-peer 0
# The share's audio has a gain of its own: core's command reaches the engine's mixer, which keeps
# it apart from the mic's (0 here, from "Mute for Me").
voice share-volume demo-peer 40
wait core engine share-volume demo-peer 40
right-click tile-demo-peer-camera
wait core dialog participant-menu open
click participant-server-mute
wait core dialog participant-menu closed
wait core requests LivekitController_muteParticipant >= 1

# 6. A screen share starts the replay buffer: the Capture button and the recording dot.
click voice-share
wait core label "Screen 1"
click picker-source-screen-1
click picker-share
wait core voice screen on within 15
wait core replay recording within 20
wait core element voice-capture
wait core element voice-recording-dot
tick 100
snap 06-live-recording

# Capture: the dialog (open only while the buffer records), the last minute into my library, and
# the web's "Recording saved". Then "Download only", saved where the (rig's) save dialog says.
server emit_segments_ready "{\"segments\": 6}"
click voice-capture
wait core dialog capture open
tick 100
snap 07-live-capture-dialog
click capture-go
wait core requests LivekitController_captureReplay >= 1
wait core dialog capture closed
wait core label "Recording saved"
save-as replay.mp4
click voice-capture
wait core dialog capture open
click capture-target-download
click capture-go
wait core requests LivekitController_streamReplay >= 1
wait core saved replay.mp4
wait core dialog capture closed
wait core label "Replay clip downloaded successfully!"
# The toast sits over the bar's middle until it goes by itself.
tick 5000
wait core no-element replay-toast

# W14: the trim's preview plays the buffer (the fake server's six 10 s segments; this build has no
# AAC, so video only). It opens paused at the selection's start (0:00 of 1:00).
click voice-capture
wait core dialog capture open
expect core preview-players 0
click capture-trim
wait core preview paused within 30
wait core preview-frames within 15
expect core preview-sound no
wait core element trim-preview-video-only
expect core preview-players 1
click trim-play-selection
wait core preview playing within 15
wait core preview-at above 0.5 within 15
# Loop on: from a second before the end, the playhead wraps to the start and plays on.
click trim-loop
click trim-jump-end
wait core preview-at above 58 within 15
wait core preview-at below 5 within 15
wait core preview playing
# Loop off: from a second before the end, it stops there (paused, or ended where the selection
# ends with the buffer).
click trim-loop
click trim-jump-end
wait core preview-at above 58 within 15
wait core preview stopped within 15
expect core preview-at above 58
# Closed, no player is left open.
click capture-cancel
wait core dialog capture closed
wait core preview none
wait core preview-players 0
click voice-share
wait core voice screen off within 15
wait core replay off within 15
wait core no-element voice-capture

# 7. Leaving.
click voice-leave
wait core voice disconnected within 15
wait core keep-awake off
wait core label "Join voice"
wait core float hidden
wait idle
shot 07-left

# 8. The captured clip is in my library, on my profile page.
click channel-$ID(cc-general)
wait core channel $ID(cc-general)
type "my clip"
press enter
wait core sent "my clip"
click-row message-author "my clip"
wait core profile-open $ID(me)
click profile-view-page
wait core route profile/$ID(me)
wait core clips 1
