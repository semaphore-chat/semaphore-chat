# W0-real-smoke: the real app against a real backend (scripts/slice-real.sh, never slice-e2e.sh),
# seeded by backend/prisma/seed-e2e.ts. {{NAME}} is an id `real-api.py ids` printed; $SERVER is the
# backend's URL. Nothing here is compared between runs: the ids and times are new every run.

# 1. Probe the server, then sign in. The refresh token comes in the body, so it is stored.
app 1280 800
wait idle
click auth-connect
wait core label "Username" within 15
click auth-username
type "testuser"
click auth-password
type "Test123!@#"
click auth-login
wait core session signed-in within 20
expect stored-session yes
wait core connection connected within 20

# 2. Lists: both seeded communities, the first one's text channels.
wait core element community-{{COMMUNITY}}
wait core element community-{{SECOND_COMMUNITY}}
click community-{{COMMUNITY}}
wait core element channel-{{CH_GENERAL}}
wait core element channel-{{CH_RANDOM}}
click channel-{{CH_GENERAL}}
wait core channel {{CH_GENERAL}}
wait idle
shot 01-general

# 3. A send, acked by its nonce, exactly once. Typed with no click into the composer: it has the
# focus after the clicks on the community and channel already open.
type "hello from native"
press enter
wait core sent "hello from native"
expect core count "hello from native" 1

# 4. Someone else's message arrives over the socket.
exec "python3 scripts/real-api.py $SERVER post-as testuser2 {{CH_GENERAL}} \"live from testuser2\""
wait core text "live from testuser2"
wait idle
shot 02-live

# 5. Mentions: one from the picker, and one of us by someone else.
type "ping @testuser2"
wait idle
shot 03-mention-menu
press enter
type "thanks"
press enter
wait core sent "ping @testuser2 thanks"
exec "python3 scripts/real-api.py $SERVER post-as testuser2 {{CH_GENERAL}} \"heads up\" testuser"
wait core text "heads up @testuser"
wait idle
shot 04-mentions

# 6. The server lists the app's session under its device name.
exec "python3 scripts/real-api.py $SERVER expect-device testuser \"Semaphore Desktop on Linux\""

# 7. A restart restores the session, and the refresh rotates the token.
remember stored-session
restart
wait core session signed-in within 20
wait core connection connected within 20
expect stored-session rotated
wait idle
shot 05-restored

# 8. The rotated-out token is refused, and reuse detection ends the session it belonged to: the app
# signs out.
expect old-refresh-token refused
wait core session signed-out within 60
expect stored-session no
wait idle
shot 06-reuse-signed-out

# 9. Sign in again, then the session is revoked from the sessions list: the app signs out.
wait core label "Username" within 15
click auth-username
type "testuser"
click auth-password
type "Test123!@#"
click auth-login
wait core session signed-in within 20
wait core connection connected within 20
exec "python3 scripts/real-api.py $SERVER revoke testuser \"Semaphore Desktop on Linux\""
wait core session signed-out within 60
expect stored-session no
wait idle
shot 07-revoked

# 10. W3: "sign out other sessions" never takes the app's own. Sign in again; web sign-ins elsewhere
# are other sessions; the app revokes the others; only the app's is left (besides the checking
# call's own), and the app stays signed in: its socket stays up, and a restart restores the session
# with its refresh token, which the server would refuse had it been revoked.
wait core label "Username" within 15
click auth-username
type "testuser"
click auth-password
type "Test123!@#"
click auth-login
wait core session signed-in within 20
wait core connection connected within 20
exec "python3 scripts/real-api.py $SERVER others testuser \"Semaphore Desktop on Linux\" some"
core revoke-other-sessions
exec "python3 scripts/real-api.py $SERVER others testuser \"Semaphore Desktop on Linux\" only"
expect core session signed-in
expect core connection connected
wait core element community-{{COMMUNITY}}
click community-{{COMMUNITY}}
wait core element channel-{{CH_GENERAL}}
click channel-{{CH_GENERAL}}
wait core channel {{CH_GENERAL}}
wait idle
shot 08-after-revoke-others
restart
wait core session signed-in within 20
wait core connection connected within 20
expect stored-session yes
exec "python3 scripts/real-api.py $SERVER expect-device testuser \"Semaphore Desktop on Linux\""
wait idle
shot 09-restored-after-revoke-others

# 11. W5 against the real backend: from the community's settings, a channel created and deleted,
# and an invite created.
wait core element community-settings within 20
click community-settings
wait core element community-tab-channels within 20
click channels-create
wait core element channel-create-name
click channel-create-name
type "w5-real"
click channel-create-submit
wait core no-element channel-create-submit within 20
wait core w5 channel "w5-real" listed within 20
wait idle
shot 10-w5-channel-created
click-label "Delete w5-real"
wait core element channel-delete-confirm
click channel-delete-confirm
wait core no-element channel-delete-confirm within 20
wait core w5 channel "w5-real" gone within 20
click community-tab-invites
wait core element invite-create within 20
click invite-create
wait core element invite-create-submit
click invite-create-submit
wait core no-element invite-create-submit within 20
wait core element invites-list within 20
wait idle
shot 11-w5-invite
click community-settings-close
wait core channel {{CH_GENERAL}} within 20
