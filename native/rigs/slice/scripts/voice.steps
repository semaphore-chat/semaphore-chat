# U13 phase 2: voice against semaphore-fake-server minting real tokens for lk-stack's LiveKit, with
# a demo publisher (`demo-peer`, video) already in Squad Up. Run by `slice-e2e.sh --voice`.
# Our camera and screens are the engine's fakes, and the picker lists the rig's two screens and a
# window, as X11 or Windows would. Snaps named *-live-* carry video and aren't compared; 06-left is.

app 1280 800
click auth-connect
wait core label "Username" within 5
click auth-username
type "alexk"
click auth-password
type "hunter2"
click auth-login
wait core session signed-in
wait core channel $ID(cc-general)
wait core connection connected

# Join: connected, the publisher seen, its video reaching a tile. The row shows the pre-join
# (WP); its Join joins.
click channel-$ID(vc-squad)
wait core element voice-prejoin-join
click voice-prejoin-join
wait core voice connected within 30
# The stage, with its own bar, is what the column shows.
wait core label "Share screen"
wait core voice participant demo-peer within 30
wait core voice frames within 30
wait core requests VoicePresenceController_joinPresence >= 1
wait core requests LivekitController_generateToken >= 1
tick 100
snap 01-live-in-call

# The heartbeat, at 1 s here: presence refreshed while the call lasts.
wait core requests VoicePresenceController_refreshPresence >= 2 within 10

# Mute and deafen.
click voice-mic
wait core voice muted
click voice-deafen
wait core voice deafened
wait core requests VoicePresenceController_updateDeafenState >= 1
click voice-deafen
wait core voice undeafened
click voice-mic
wait core voice unmuted

# The camera: on, our own preview on the stage, then off.
wait core label "Turn on camera"
click voice-camera
wait core voice camera on within 15
wait core voice own-frames camera within 15
wait core label "Turn off camera"
tick 100
snap 02-live-camera-on
click voice-camera
wait core voice camera off within 15
wait core label "Turn on camera"

# The settings page's camera test: the selected camera's picture in the preview, nothing published,
# then Stop lets the camera go.
click rail-account
wait core label "Settings"
click account-settings
click settings-tab-voice
wait core route settings/voice
# A wheel over the page (not the call's float card, which takes the wheel where it covers the
# page) scrolls it down to the camera test.
scroll voice-mic-test 0 -700
wait idle
click voice-camera-test
wait core camera-test running
wait core camera-test device default
wait core camera-test frames 1 within 15
# The preview surface draws those frames, as a call's own camera tile does.
wait core element voice-camera-preview within 15
expect core voice camera off
click voice-camera-test
wait core camera-test stopped
wait core camera-test released
click settings-close
wait core label "Turn on camera"

# A camera that won't open: the bar says why, and clicking again retries.
video fail-next camera "the camera is in use by another application"
click voice-camera
wait core voice camera failed within 15
wait core label "Retry camera"
expect core voice connected
click voice-camera
wait core voice camera on within 15
click voice-camera
wait core voice camera off within 15

# Screen share through our picker: two screens and a window, pick one, share. There's no PipeWire in
# a container, so its audio fails and the screen is shared anyway, on our own stage.
click voice-share
wait core label "Screen 2"
wait core label "Windows (1)"
tick 100
snap 03-live-picker
click picker-source-screen-2
click picker-share
wait core voice screen on within 15
wait core voice screen-audio failed within 15
wait core voice own-frames screen within 15
wait core label "Stop sharing screen"
expect core voice connected
tick 100
snap 04-live-sharing-self
click voice-share
wait core voice screen off within 15
wait core label "Share screen"

# A picker cancelled shares nothing.
click voice-share
wait core label "Screen 1"
click picker-cancel
expect core voice screen off

# Elsewhere in the app, the call's bar stays under the columns.
click channel-$ID(cc-general)
wait core channel $ID(cc-general)
wait core label "Share screen"
expect core voice connected
tick 100
snap 05-live-bar-elsewhere

# A camera left on goes off with the call.
click voice-camera
wait core voice camera on within 15

# A moderator removes us: the call ends here, and the server hears we left.
livekit remove $ID(vc-squad) $ID(me)
wait core voice disconnected within 15
wait core requests VoicePresenceController_leavePresence >= 1
expect core voice camera off

# A new call (through Squad Up's pre-join), then leaving it from the bar. LiveKit lists the
# removed participant for a moment after the removal, and a rejoin before it goes is refused with
# ParticipantRemoved: wait for the room to let them go.
wait core livekit participant $ID(vc-squad) $ID(me) gone
click channel-$ID(vc-squad)
wait core element voice-prejoin-join
click voice-prejoin-join
wait core voice connected within 30
wait core voice participant demo-peer within 30
click voice-leave
wait core voice disconnected
wait core requests VoicePresenceController_leavePresence >= 2
wait core label "Join voice"
wait idle
shot 06-left
