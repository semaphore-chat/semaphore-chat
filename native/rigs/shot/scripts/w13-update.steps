# W13: the update card in each state, in the shell's notice corner, and the settings row's
# states, at desktop and phone width.
# Render: scripts/in-image.sh rigs/shot/review.sh rigs/shot/scripts/w13-update.steps
story shell-update-available 1280 800 dark-blue-balanced
wait idle
shot w13-shell-update-available-desktop
story shell-update-available 390 844 light-blue-balanced
wait idle
shot w13-shell-update-available-phone
