# UV the voice pre-join panel: every state, each on a desktop (dark) and a phone (light).
# Render: scripts/in-image.sh rigs/shot/review.sh rigs/shot/scripts/uv-voice-prejoin.steps
story voice-prejoin-loading 1280 800 dark-blue-balanced
wait idle
shot uv-prejoin-loading-desktop
