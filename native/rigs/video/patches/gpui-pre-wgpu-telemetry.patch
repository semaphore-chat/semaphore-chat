--- a/src/telemetry.rs
+++ b/src/telemetry.rs
@@ -0,0 +1,23 @@
+//! RIG ONLY, not part of the video patch: counters the rig reads.
+use parking_lot::Mutex;
+use std::sync::atomic::{AtomicI64, AtomicU64, Ordering::Relaxed};
+use std::time::Instant;
+
+static TEXTURES_CREATED: AtomicU64 = AtomicU64::new(0);
+static ATLAS_LIVE_BYTES: AtomicI64 = AtomicI64::new(0);
+static PRESENTS: Mutex<Vec<Instant>> = Mutex::new(Vec::new());
+
+pub fn note_texture_created(n: u64) { TEXTURES_CREATED.fetch_add(n, Relaxed); }
+pub fn note_atlas_alloc(bytes: i64) { ATLAS_LIVE_BYTES.fetch_add(bytes, Relaxed); }
+pub fn note_present() { PRESENTS.lock().push(Instant::now()); }
+pub fn textures_created() -> u64 { TEXTURES_CREATED.load(Relaxed) }
+pub fn atlas_live_bytes() -> i64 { ATLAS_LIVE_BYTES.load(Relaxed) }
+pub fn take_presents() -> Vec<Instant> { std::mem::take(&mut *PRESENTS.lock()) }
+
+static DEVICE: std::sync::OnceLock<std::sync::Arc<wgpu::Device>> = std::sync::OnceLock::new();
+pub fn set_device(device: std::sync::Arc<wgpu::Device>) { let _ = DEVICE.set(device); }
+/// (allocated, reserved) bytes from wgpu's allocator.
+pub fn allocator() -> Option<(u64, u64)> {
+    let report = DEVICE.get()?.generate_allocator_report()?;
+    Some((report.total_allocated_bytes, report.total_reserved_bytes))
+}
